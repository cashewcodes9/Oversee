# Copy to .env and adjust as needed
POSTGRES_USER=oversee
POSTGRES_PASSWORD=oversee
POSTGRES_DB=oversee
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Live AIS feed: free key from https://aisstream.io (sign in with GitHub, then Account)
AISSTREAM_API_KEY=

# Logging: text (local) or json (containers)
LOG_LEVEL=INFO
LOG_FORMAT=text

# Used by the dashboard to reach the API
API_BASE_URL=http://localhost:8000
