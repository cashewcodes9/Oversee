# Copy to .env and adjust as needed
POSTGRES_USER=oversee
POSTGRES_PASSWORD=oversee
POSTGRES_DB=oversee
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Raw data lake: the SeaweedFS `lake` service (docker compose up -d --wait lake).
# Set LAKE_ROOT=data/lake and drop the S3_* lines to use a local directory instead.
# For AWS S3, set LAKE_ROOT=s3://<bucket> and drop the S3_* lines (AWS credential chain).
LAKE_ROOT=s3://oversee-lake
S3_ENDPOINT=localhost:8333
S3_ACCESS_KEY_ID=oversee
S3_SECRET_ACCESS_KEY=oversee-secret
S3_USE_SSL=false
S3_URL_STYLE=path

# DuckDB memory cap; above it DuckDB spills to DUCKDB_TEMP_DIR instead of failing
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_TEMP_DIR=data/tmp/duckdb

# Live AIS feed: free key from https://aisstream.io (sign in with GitHub, then Account)
AISSTREAM_API_KEY=

# Logging: text (local) or json (containers)
LOG_LEVEL=INFO
LOG_FORMAT=text

# Used by the dashboard to reach the API
API_BASE_URL=http://localhost:8000
